# KUSANYA — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-50-character-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) -------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://kusanya:kusanya@localhost:5432/kusanya

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Email (console backend in development; real SMTP later) --------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- SMS provider (placeholder — no provider integrated yet) --------------
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# --- Payment provider credentials ------------------------------------------
# Intentionally blank. KUSANYA ships with a MOCK/SANDBOX provider only
# until a licensed provider's official credentials and API documentation
# are available. See docs/PAYMENT_PROVIDER_ARCHITECTURE.md and
# docs/compliance/REGULATORY_ASSUMPTIONS.md.
PAYMENT_PROVIDER_MOCK_ENABLED=True

# --- Webhook signing ---------------------------------------------------------
WEBHOOK_SIGNING_SECRET=change-me

# --- Encryption (apps.core.encrypted_fields, ADR-032) ------------------------
# Required in production (fails loudly at startup if unset — see
# config/settings/production.py); dev/test fall back to a key derived
# from DJANGO_SECRET_KEY, so this can stay blank locally. Rotating this
# value makes every already-encrypted field unreadable — back it up with
# at least the same care as the database itself.
FIELD_ENCRYPTION_KEY=

# --- CORS / CSRF (production) ------------------------------------------------
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Observability -------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Platform alerting (apps.core.tasks.monitor_system_health, ADR-031) ------
# Comma-separated list of emails to notify when the scheduled health check
# fails. Empty means no one is notified (a safe no-op, not an error).
PLATFORM_ALERT_EMAILS=
SERVER_EMAIL=kusanya@localhost
DEFAULT_FROM_EMAIL=kusanya@localhost
# Real SMTP wiring (production only) -- inert until set, same as SENTRY_DSN.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- General request rate limiting (apps.core.ratelimit, ADR-030) -----------
REQUEST_RATE_LIMIT=120
REQUEST_RATE_LIMIT_WINDOW_SECONDS=60

# --- Environment marker --------------------------------------------------------
ENVIRONMENT=development
